---
// Concept A "Sunrise Book": a sun rising over an open book.
interface Props {
  size?: number;
  sun?: string;
  book?: string;
  class?: string;
}
const { size = 44, sun = '#E8772E', book = '#1B2A41', class: className } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 120 120" aria-hidden="true" class={className}>
  <g stroke={sun} stroke-width="7" stroke-linecap="round">
    <line x1="60" y1="32" x2="60" y2="20"></line>
    <line x1="76" y1="36.3" x2="82" y2="25.9"></line>
    <line x1="87.7" y1="48" x2="98.1" y2="42"></line>
    <line x1="44" y1="36.3" x2="38" y2="25.9"></line>
    <line x1="32.3" y1="48" x2="21.9" y2="42"></line>
  </g>
  <path d="M32 66 A28 28 0 0 1 88 66 Z" fill={sun}></path>
  <path d="M10 74 Q35 66 58 76 L58 106 Q35 96 10 104 Z" fill={book}></path>
  <path d="M110 74 Q85 66 62 76 L62 106 Q85 96 110 104 Z" fill={book}></path>
</svg>
