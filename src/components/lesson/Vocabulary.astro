---
interface Props {
  words: { word: string; pos: string; meaning: string; example: string; t?: number }[];
  hasVideo: boolean;
}
const { words, hasVideo } = Astro.props;
---
<section class="vocab" id="words" data-vocab aria-labelledby="vocab-title">
  <div class="v-head">
    <div>
      <p class="eyebrow">Step 3</p>
      <h2 id="vocab-title">Words from the story</h2>
      <p class="v-sub">Say the word, guess its meaning, then flip the card. Keep the ones you know, and practise the rest again.</p>
    </div>
    <div class="v-stats">
      <div class="ring" data-ring style="--p: 0">
        <span data-known>0</span><small>/ {words.length}</small>
      </div>
      <span>words learned</span>
    </div>
  </div>

  <div class="v-tabs" role="group" aria-label="View">
    <button type="button" class="chip" data-view="cards" aria-pressed="true">Flashcards</button>
    <button type="button" class="chip" data-view="list" aria-pressed="false">All words</button>
    <button type="button" class="chip" data-view="review" aria-pressed="false" data-review-btn>Practise again (<span data-learning>0</span>)</button>
  </div>

  <div class="deck-area" data-cards>
    <div class="deck" translate="no">
      {words.map((w, i) => (
        <div class="fc" data-card={i} hidden={i !== 0}>
          <button type="button" class="fc-inner" data-flip aria-label={`Flip card: ${w.word}`}>
            <span class="face front">
              <span class="fc-pos">{w.pos}</span>
              <span class="fc-word">{w.word}</span>
              <span class="fc-hint">Tap to see the meaning</span>
            </span>
            <span class="face back">
              <span class="fc-pos">{w.word} · {w.pos}</span>
              <span class="fc-meaning" translate="yes">{w.meaning}</span>
              <span class="fc-example">“{w.example}”</span>
            </span>
          </button>
          <span class="fc-status" data-status></span>
        </div>
      ))}
    </div>

    <div class="deck-nav">
      <button type="button" class="round" data-prev aria-label="Previous word">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
      </button>
      <span class="count" aria-live="polite"><span data-pos>1</span> / <span data-total>{words.length}</span></span>
      <button type="button" class="round" data-next aria-label="Next word">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
      </button>
    </div>

    <div class="deck-actions">
      <button type="button" class="btn btn-ghost btn-sm" data-say>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4V5z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7"></path><path d="M19 5a10 10 0 0 1 0 14"></path></svg>
        Listen
      </button>
      {hasVideo && (
        <button type="button" class="btn btn-ghost btn-sm" data-hear>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
          Hear it in the video
        </button>
      )}
      <span class="spacer"></span>
      <button type="button" class="btn btn-sm judge learning" data-judge="learning">Still learning</button>
      <button type="button" class="btn btn-sm judge known" data-judge="known">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg>
        I know this
      </button>
    </div>
    <p class="done-note" data-done hidden>Great work, you know every word in this story. Now try the quiz below.</p>
  </div>

  <ul class="list" data-list hidden translate="no">
    {words.map((w, i) => (
      <li data-li={i}>
        <button type="button" class="say-sm" data-say-word={i} aria-label={`Listen: ${w.word}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6 9H2v6h4l5 4V5z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7"></path></svg>
        </button>
        <div>
          <p><strong>{w.word}</strong> <em>{w.pos}</em> <span class="li-status" data-li-status></span></p>
          <p class="li-meaning" translate="yes">{w.meaning}</p>
          <p class="li-example">“{w.example}”</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .vocab {
    display: grid;
    gap: 24px;
  }
  .v-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
  }
  .v-head > div:first-child {
    display: grid;
    gap: 8px;
    max-width: 60ch;
  }
  .v-sub {
    color: var(--muted);
  }
  .v-stats {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .ring {
    --p: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    grid-auto-flow: column;
    align-content: center;
    gap: 2px;
    background:
      radial-gradient(closest-side, var(--cream) 78%, transparent 80% 100%),
      conic-gradient(var(--orange) calc(var(--p) * 1%), var(--sand-deep) 0);
    color: var(--navy);
  }
  .ring span {
    font: 700 22px var(--serif);
  }
  .ring small {
    font-size: 12px;
  }
  .v-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .deck-area {
    display: grid;
    gap: 18px;
    justify-items: center;
  }
  .deck {
    width: min(100%, 560px);
    perspective: 1400px;
  }
  .fc {
    position: relative;
  }
  .fc-inner {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transform-style: preserve-3d;
    transition: transform 0.55s cubic-bezier(0.3, 0.7, 0.2, 1);
    font: inherit;
    color: inherit;
  }
  .fc.flipped .fc-inner {
    transform: rotateY(180deg);
  }
  .face {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 12px;
    padding: 28px;
    border-radius: 22px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    text-align: center;
  }
  .front {
    background: var(--navy);
    color: var(--cream);
    box-shadow: 0 20px 40px -20px rgb(27 42 65 / 0.6);
    background-image:
      radial-gradient(circle at 50% 118%, rgb(244 182 63 / 0.35) 0 22%, transparent 22.5%),
      radial-gradient(circle at 50% 118%, rgb(244 182 63 / 0.14) 0 34%, transparent 34.5%);
  }
  .back {
    background: var(--white);
    color: var(--navy);
    transform: rotateY(180deg);
    box-shadow: var(--shadow), 0 0 0 2px var(--gold);
  }
  .fc-pos {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .back .fc-pos {
    color: var(--rust);
  }
  .fc-word {
    font: 600 clamp(38px, 7vw, 56px) / 1.05 var(--serif);
  }
  .fc-hint {
    font-size: 14px;
    color: #b9c1cf;
  }
  .fc-meaning {
    font: 500 clamp(19px, 2.6vw, 23px) / 1.4 var(--sans);
  }
  .fc-example {
    font: italic 400 18px/1.5 var(--serif);
    color: var(--muted);
  }
  .fc-status {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    pointer-events: none;
  }
  .fc-status:not(:empty) {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
  }
  .fc-status[data-s='known'] {
    background: var(--ok-soft);
    color: var(--ok);
  }
  .fc-status[data-s='learning'] {
    background: var(--gold-soft);
    color: var(--rust);
  }
  .deck-nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .count {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    min-width: 64px;
    text-align: center;
  }
  .round {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1.5px solid var(--navy);
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
  }
  .round:hover {
    background: var(--sand);
  }
  .deck-actions {
    width: min(100%, 720px);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: center;
  }
  .spacer {
    flex: 1 1 0;
  }
  .judge.learning {
    background: var(--gold-soft);
    color: var(--rust);
  }
  .judge.learning:hover {
    background: #f9df9f;
  }
  .judge.known {
    background: var(--ok);
    color: var(--white);
  }
  .judge.known:hover {
    background: #256a4c;
  }
  .done-note {
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--ok-soft);
    color: var(--ok);
    font-weight: 600;
    text-align: center;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
  }
  .list li {
    display: flex;
    gap: 14px;
    padding: 18px;
    background: var(--white);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }
  .list strong {
    font: 600 20px var(--serif);
  }
  .list em {
    font-size: 13px;
    color: var(--muted);
  }
  .li-meaning {
    margin-top: 4px;
  }
  .li-example {
    font: italic 15px/1.5 var(--serif);
    color: var(--muted);
    margin-top: 4px;
  }
  .li-status:not(:empty) {
    margin-left: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    background: var(--ok-soft);
    color: var(--ok);
  }
  .say-sm {
    flex: none;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 0;
    background: var(--sand);
    color: var(--navy);
    cursor: pointer;
  }
  .say-sm:hover {
    background: var(--gold-soft);
  }
  @media (max-width: 560px) {
    .spacer {
      display: none;
    }
    .fc-inner {
      aspect-ratio: 4 / 3.4;
    }
  }
</style>
