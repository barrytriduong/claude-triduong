---
interface Props {
  youtubeId: string;
  title: string;
  cover?: string;
}
const { youtubeId, title, cover } = Astro.props;
const thumb = youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : cover;
---
<div class="video" data-video data-youtube-id={youtubeId}>
  <div class="frame">
    {youtubeId ? (
      <button type="button" class="facade" data-play aria-label={`Play video: ${title}`}>
        <img src={thumb} alt="" loading="eager" width="480" height="360" />
        <span class="play" aria-hidden="true">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg>
        </span>
      </button>
    ) : (
      <div class="soon">
        {cover && <img src={cover} alt="" width="960" height="540" />}
        <div class="soon-label">
          <strong>Video coming soon</strong>
          <span>Read along with the transcript below, and tap any line to hear it.</span>
        </div>
      </div>
    )}
    <div class="player" data-player></div>
  </div>

  {youtubeId && (
    <div class="controls" aria-label="Video controls">
      <div class="group" role="group" aria-label="Playback speed">
        <span class="label">Speed</span>
        {['0.75', '1', '1.25'].map((r) => (
          <button type="button" class="ctl" data-rate={r} aria-pressed={r === '1' ? 'true' : 'false'}>{r}×</button>
        ))}
      </div>
      <button type="button" class="ctl loop" data-loop aria-pressed="false" title="Replay the current sentence again and again">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 2l4 4-4 4"></path><path d="M3 11V9a3 3 0 0 1 3-3h15"></path><path d="M7 22l-4-4 4-4"></path><path d="M21 13v2a3 3 0 0 1-3 3H3"></path></svg>
        Repeat sentence
      </button>
    </div>
  )}
</div>

<style>
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--navy);
    box-shadow: var(--shadow);
  }
  .facade,
  .soon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: var(--navy);
  }
  .facade {
    cursor: pointer;
  }
  .facade img,
  .soon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .facade:hover .play {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 84px;
    height: 84px;
    display: grid;
    place-items: center;
    padding-left: 4px;
    border-radius: 50%;
    background: var(--orange);
    color: var(--navy);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.3);
    transition: transform 0.15s ease;
  }
  .soon-label {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    display: grid;
    gap: 2px;
    padding: 14px 18px;
    background: rgb(27 42 65 / 0.88);
    color: var(--cream);
    border-radius: var(--radius-sm);
    font-size: 15px;
  }
  .soon-label strong {
    font-family: var(--serif);
    font-size: 19px;
    color: var(--gold);
  }
  .player,
  .player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .player:empty {
    display: none;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    align-items: center;
    margin-top: 14px;
  }
  .group {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .label {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    margin-right: 4px;
  }
  .ctl {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--navy);
    font: 600 14px var(--sans);
    cursor: pointer;
  }
  .ctl:hover {
    border-color: var(--navy);
  }
  .ctl[aria-pressed='true'] {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--cream);
  }
</style>
