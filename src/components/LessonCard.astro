---
import type { CollectionEntry } from 'astro:content';
import { LEVEL_INFO } from '../lib/levels';

interface Props {
  lesson: CollectionEntry<'lessons'>;
}
const { lesson } = Astro.props;
const d = lesson.data;
const img = d.youtubeId ? `https://i.ytimg.com/vi/${d.youtubeId}/hqdefault.jpg` : d.cover;
---
<article class="lcard card" data-level={d.level} data-topics={d.topics.join('|')} data-slug={lesson.id}>
  <a href={`/lessons/${lesson.id}/`} class="media">
    {img && <img src={img} alt="" loading="lazy" width="640" height="360" />}
    {d.duration && <span class="dur">{d.duration}</span>}
    <span class="done-badge" data-done-badge hidden>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"></path></svg>
      <span data-done-text>Done</span>
    </span>
  </a>
  <div class="body">
    <div class="meta">
      <span class="level"><b>{d.level}</b> {LEVEL_INFO[d.level].name}</span>
      <span class="tag">{d.topics.slice(0, 2).join(' · ')}</span>
    </div>
    <h3><a href={`/lessons/${lesson.id}/`}>{d.title}</a></h3>
    <p>{d.summary}</p>
  </div>
</article>

<style>
  .lcard {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .lcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 2px 4px rgb(27 42 65 / 0.06), 0 18px 40px -16px rgb(27 42 65 / 0.3);
  }
  .media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--sand);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dur,
  .done-badge {
    position: absolute;
    bottom: 10px;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
  }
  .dur {
    right: 10px;
    background: rgb(27 42 65 / 0.85);
    color: var(--cream);
  }
  .done-badge {
    left: 10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--ok);
    color: var(--white);
  }
  .done-badge[hidden] {
    display: none;
  }
  .body {
    display: grid;
    gap: 10px;
    padding: 20px 22px 24px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  h3 a {
    color: var(--navy);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--rust);
  }
  .body p {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.55;
  }
</style>

<script>
  // Show "Done" / progress on cards for lessons this learner has worked on.
  document.querySelectorAll<HTMLElement>('.lcard[data-slug]').forEach((card) => {
    try {
      const p = JSON.parse(localStorage.getItem(`ble:progress:${card.dataset.slug}`) || '{}');
      const n = ['watch', 'read', 'words', 'quiz'].filter((k) => p[k]).length;
      if (!n) return;
      const badge = card.querySelector<HTMLElement>('[data-done-badge]')!;
      badge.hidden = false;
      if (n < 4) badge.querySelector('[data-done-text]')!.textContent = `${n}/4 steps`;
    } catch {}
  });
</script>
