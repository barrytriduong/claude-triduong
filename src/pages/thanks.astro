---
import Base from '../layouts/Base.astro';
import LogoMark from '../components/LogoMark.astro';
---
<Base title="You're in!" description="Thanks for joining the Bright Lives English newsletter.">
  <section class="wrap section box">
    <LogoMark size={96} />
    <h1>You're in. Thank you!</h1>
    <p class="lede">Look out for your first email with the newest story, five useful words and a study tip.</p>
    <a class="btn btn-primary" href="/lessons/">Start a lesson now</a>
  </section>
</Base>
<style>
  .box {
    display: grid;
    gap: 20px;
    justify-items: center;
    text-align: center;
  }
</style>
