---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LessonCard from '../components/LessonCard.astro';
import BlogCard from '../components/BlogCard.astro';
import LogoMark from '../components/LogoMark.astro';
import { LEVELS, LEVEL_INFO } from '../lib/levels';
import { SITE } from '../lib/site';
import { highlight, fmtTime } from '../lib/highlight';

const byDate = (a: any, b: any) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
const lessons = (await getCollection('lessons', (l) => !l.data.draft)).sort(byDate);
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(byDate).slice(0, 3);
const featured = lessons[0];
const f = featured?.data;
const fImg = f && (f.youtubeId ? `https://i.ytimg.com/vi/${f.youtubeId}/hqdefault.jpg` : f.cover);
const fWord = f?.vocabulary[0];
// A transcript line that contains the featured word, for the floating "follow along" chip
const fLine = f && (f.transcript.find((l, i) => i > 2 && fWord && highlight(l.text, [fWord]).some((x) => x.word !== undefined)) ?? f.transcript[0]);

const steps = [
  { t: 'Watch', d: 'A short, true story about a real person. Slow it down or repeat any sentence.', icon: 'play' },
  { t: 'Read along', d: 'The transcript follows the video. Tap any line to jump there, and any highlighted word to see its meaning.', icon: 'text' },
  { t: 'Learn the words', d: 'Flip the flashcards, hear each word, and keep practising the ones you don’t know yet.', icon: 'cards' },
  { t: 'Story Challenge', d: 'A quick game: choose, fill the gap, build the sentence and match the pairs. Build a streak!', icon: 'star' },
];
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Learn English with inspiring true stories</p>
        <h1>Real stories.<br /><em>Real English.</em></h1>
        <p class="lede">Short videos about real people who did something brave, kind or surprising, turned into English lessons you'll actually enjoy. Free, from A1 to C2.</p>
        <div class="cta">
          {featured && <a class="btn btn-primary" href={`/lessons/${featured.id}/`}>Start a free lesson</a>}
          <a class="btn btn-ghost" href="/levels/">Find your level</a>
        </div>
        <ul class="points">
          <li>No sign-up needed</li>
          <li>New story every week</li>
          <li>Translate the site into 12 languages</li>
        </ul>
      </div>

      {featured && (
        <div class="hero-art" aria-hidden="true">
          <div class="art-glow"></div>
          <a class="art-video" href={`/lessons/${featured.id}/`} tabindex="-1">
            <img src={fImg} alt="" width="960" height="540" />
            <span class="art-play"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg></span>
          </a>
          <div class="float f-line">
            <span class="f-time">{fmtTime(fLine.t)}</span>
            <span>{fLine.text.split(' ').slice(0, 6).join(' ')}{fLine.text.split(' ').length > 6 ? '…' : ''}</span>
          </div>
          {fWord && (
            <div class="float f-word">
              <span class="f-pos">{fWord.pos}</span>
              <strong>{fWord.word}</strong>
              <span class="f-mean">{fWord.meaning}</span>
            </div>
          )}
          <div class="float f-streak">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c1 3.5 5 5.8 5 11a5 5 0 0 1-10 0c0-2.4 1.1-3.8 2.3-5 .2 1.6.9 2.7 2.2 3.3C11 8 10.8 5 12 2z"></path></svg>
            4 in a row · +160
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="section how">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">How it works</p>
          <h2>Every lesson, four simple steps</h2>
        </div>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="card">
            <span class="s-icon" aria-hidden="true">
              {s.icon === 'play' && <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg>}
              {s.icon === 'text' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 11h16M4 16h10"></path></svg>}
              {s.icon === 'cards' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="7" width="13" height="13" rx="2"></rect><path d="M8 4h11a2 2 0 0 1 2 2v11"></path></svg>}
              {s.icon === 'star' && <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l2.9 6 6.6.8-4.9 4.6 1.3 6.5L12 17.2l-5.9 3.2 1.3-6.5L2.5 9.3l6.6-.8z"></path></svg>}
            </span>
            <span class="s-num">0{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section levels-band">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Choose your level</p>
          <h2>Stories for every learner, A1 to C2</h2>
        </div>
        <a class="btn btn-ghost btn-sm" href="/levels/">Not sure? Take the 1-minute check</a>
      </div>
      <div class="lv-grid">
        {LEVELS.map((l) => (
          <a class="lv" href={`/lessons/?level=${l}`}>
            <span class="lv-code">{l}</span>
            <span class="lv-name">{LEVEL_INFO[l].name}</span>
            <span class="lv-can">{LEVEL_INFO[l].can}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Latest lessons</p>
          <h2>Meet this week's stories</h2>
        </div>
        <a class="btn btn-ghost btn-sm" href="/lessons/">All lessons</a>
      </div>
      <div class="grid-cards">
        {lessons.slice(0, 6).map((l) => <LessonCard lesson={l} />)}
      </div>
    </div>
  </section>

  <section class="why">
    <div class="wrap why-grid">
      <LogoMark size={120} sun="#F4B63F" book="#FBF6EC" />
      <div>
        <p class="why-quote">“When you care about a person, you remember the words they used.”</p>
        <p class="why-text">Textbook dialogues are easy to forget. A true story about courage, kindness or a crazy dream stays with you, and so does its English. That's why every Bright Lives lesson starts with a real life.</p>
        <a class="btn btn-sun" href={SITE.youtubeSubscribe} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
          Subscribe on YouTube
        </a>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">From the blog</p>
            <h2>Learn smarter, not harder</h2>
          </div>
          <a class="btn btn-ghost btn-sm" href="/blog/">All articles</a>
        </div>
        <div class="grid-cards">
          {posts.map((p) => <BlogCard post={p} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 88px) clamp(40px, 6vw, 72px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero-copy {
    display: grid;
    gap: 22px;
  }
  .hero h1 {
    font-size: clamp(46px, 7.4vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .hero h1 em {
    font-weight: 500;
    color: var(--rust);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .points li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .points li::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--orange);
  }
  .hero-art {
    position: relative;
    padding: 36px 24px 56px;
  }
  .art-glow {
    position: absolute;
    inset: -10% -20% 0 10%;
    background: radial-gradient(closest-side, var(--gold-soft), transparent);
    z-index: -1;
  }
  .art-video {
    position: relative;
    display: block;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    box-shadow: 0 30px 60px -30px rgb(27 42 65 / 0.55);
    transform: rotate(-1.5deg);
  }
  .art-video img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .art-play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 68px;
    height: 68px;
    display: grid;
    place-items: center;
    padding-left: 3px;
    border-radius: 50%;
    background: var(--orange);
    color: var(--navy);
  }
  .float {
    position: absolute;
    background: var(--white);
    border-radius: 14px;
    box-shadow: var(--shadow), 0 0 0 1px var(--line);
    font-size: 14px;
  }
  .f-line {
    left: -8px;
    bottom: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    background: var(--gold-soft);
    animation: bob 5s ease-in-out infinite;
  }
  .f-time {
    padding: 4px 8px;
    border-radius: 8px;
    background: var(--white);
    font-weight: 700;
    font-size: 12px;
  }
  .f-word {
    right: 0;
    top: 0;
    display: grid;
    gap: 2px;
    width: 210px;
    padding: 14px 16px;
    background: var(--navy);
    color: var(--cream);
    transform: rotate(3deg);
    animation: bob 6s ease-in-out -2s infinite;
  }
  .f-word strong {
    font: 600 24px var(--serif);
    color: var(--gold);
  }
  .f-pos {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b9c1cf;
  }
  .f-mean {
    font-size: 13px;
    line-height: 1.4;
  }
  .f-streak {
    right: 24px;
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    font-weight: 700;
    color: var(--rust);
    animation: bob 5.5s ease-in-out -1s infinite;
  }
  @keyframes bob {
    50% {
      translate: 0 -6px;
    }
  }
  .how {
    background: var(--sand);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .steps li {
    position: relative;
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 26px 24px 28px;
  }
  .s-icon {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    background: var(--navy);
    color: var(--gold);
    margin-bottom: 6px;
  }
  .s-num {
    position: absolute;
    right: 22px;
    top: 22px;
    font: 600 34px var(--serif);
    color: var(--sand-deep);
  }
  .steps p {
    font-size: 15px;
    color: var(--muted);
  }
  .lv-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }
  .lv {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 22px 18px;
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow);
    color: var(--navy);
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .lv:hover {
    transform: translateY(-3px);
    background: var(--navy);
    color: var(--cream);
  }
  .lv:hover .lv-can {
    color: #d7dce5;
  }
  .lv:hover .lv-code {
    color: var(--gold);
  }
  .lv-code {
    font: 600 40px/1 var(--serif);
    color: var(--rust);
  }
  .lv-name {
    font-weight: 700;
  }
  .lv-can {
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
  }
  .why {
    background: var(--navy);
    color: var(--cream);
    padding-block: clamp(56px, 8vw, 96px);
  }
  .why-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  .why-grid > div {
    display: grid;
    gap: 20px;
    justify-items: start;
    max-width: 760px;
  }
  .why-quote {
    font: 500 clamp(28px, 4vw, 44px) / 1.2 var(--serif);
    letter-spacing: -0.015em;
  }
  .why-text {
    color: #d7dce5;
    font-size: 18px;
  }
  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .lv-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      max-width: 560px;
    }
  }
  @media (max-width: 560px) {
    .steps,
    .lv-grid {
      grid-template-columns: 1fr 1fr;
    }
    .steps {
      grid-template-columns: 1fr;
    }
    .why-grid {
      grid-template-columns: 1fr;
    }
    .f-word {
      width: 170px;
    }
    .hero-art {
      padding-inline: 8px;
    }
  }
</style>
